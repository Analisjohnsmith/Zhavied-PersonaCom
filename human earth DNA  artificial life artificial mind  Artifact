@jit(nopython=True)
def regen_resources_numba(resource_array, regen_rate, dt):
    rows, cols = resource_array.shape
    for i in range(rows):
        for j in range(cols):
            resource_array[i, j] = min(1.0, resource_array[i, j] + regen_rate * dt)

